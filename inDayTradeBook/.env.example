# Fubon credentials
FUBON_ID=
FUBON_PASSWORD=
FUBON_CERT_PATH=
# Leave blank if the certificate uses the default/no certificate password.
FUBON_CERT_PASSWORD=
FUBON_MODE=Speed
# Optional. Leave empty for production default.
# For Fubon test env: wss://neoapitest.fbs.com.tw/TASP/XCPXWS
FUBON_WS_URL=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Collector
SYMBOLS=2330,2308,3105
CHANNELS=trades,books
RECONNECT_DELAY_SECONDS=3
